# All runtime + Docker Compose config lives here now — nothing at the project
# root. Copy this to backend/.env and fill in real values. Because everything
# is here, every `docker compose` command must be run with
# --env-file backend/.env (e.g. `docker compose --env-file backend/.env up -d`),
# otherwise Compose falls back to the hardcoded defaults in docker-compose.yml
# instead of these real values.

# --- Database (read by docker-compose.yml for the postgres service's own
# environment block, and for the backend's DATABASE_URL fallback) ---
POSTGRES_USER=wa_auto
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wa_auto
DATABASE_URL=postgresql://wa_auto:change_me@postgres:5432/wa_auto?schema=public

# --- Redis / background jobs ---
REDIS_URL=redis://redis:6379

# --- WhatsApp session volume mount path ---
WHATSAPP_SESSION_PATH=/data/wwebjs_auth

# --- Frontend build-time (baked into the Docker image at build time) ---
# Relative path works behind the bundled nginx reverse proxy (frontend/nginx.conf
# forwards /api/ to the backend container) — this is what makes the app work
# through a single tunnel/domain (e.g. ngrok) without a separate API URL.
VITE_API_BASE_URL=/api

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string

# --- App URLs ---
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
PORT=4000

# --- WhatsApp (whatsapp-web.js / Puppeteer) ---
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WHATSAPP_NOTIFICATION_NUMBER=

# --- Email (SMTP, e.g. via nodemailer) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com

# --- AI (conversation engine, knowledge extraction, sales message drafts) ---
# Leave blank to disable AI features gracefully (training stores raw text but
# won't extract structured facts; no auto-replies are sent). Get a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Renewal reminders (comma-separated days-before-expiry; defaults to 7,3,1,0) ---
RENEWAL_REMINDER_DAYS=7,3,1,0

# --- Payments (Razorpay) — leave blank to disable online checkout gracefully ---
# Key ID + Secret: Settings -> API Keys in the Razorpay dashboard.
# Webhook Secret: Settings -> Webhooks -> add endpoint https://<your-domain>/api/webhooks/razorpay,
# subscribe to the "payment.captured" event, then paste its signing secret here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Seed script (backend/prisma/seed.ts) ---
# Only used to create the very first SUPER_ADMIN, and only if no SUPER_ADMIN
# exists yet in the database — the seed script checks by role, not by this
# email, so it can never create a second/backdoor admin later even after you've
# changed the real admin's email or password from the admin panel. Once your
# first admin exists, these are no longer read for anything and can be left
# blank or removed.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
